# ==== App ====
APP_NAME=CHEMGENIE
ENVIRONMENT=development
DEBUG=true

# ==== Database ====
DATABASE_URL=postgresql+psycopg2://chemgenie:chemgenie@localhost:5432/chemgenie

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== JWT ====
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== CORS ====
CORS_ORIGINS=http://localhost:3000

# ==== AI Providers (KHÔNG commit giá trị thật) ====
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==== Vector DB (dùng chung Postgres qua pgvector, để trống nếu dùng chung DATABASE_URL) ====
VECTOR_DATABASE_URL=
